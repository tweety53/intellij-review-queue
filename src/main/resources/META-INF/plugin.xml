<idea-plugin>
    <id>dev.tweety.reviewqueue</id>
    <name>Review Queue</name>
    <vendor>tweety53</vendor>

    <description><![CDATA[
        Review the files in a staged diff, a branch-vs-base diff, or a commit range one at a time,
        marking each as reviewed. Reviewed marks are content-addressed, so editing a file returns it
        to the unreviewed set.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!--
          KAN-5 removed the tool window. The notification group stays — it is unrelated to the window,
          and it is now how failed roots and empty scopes are reported. The startup activity stays
          too: ReviewLayoutRestorer still restores the Project tool window after a pass.
        -->
        <notificationGroup id="Review Queue" displayType="BALLOON"/>
        <postStartupActivity implementation="dev.tweety.reviewqueue.ui.ReviewLayoutRestorer"/>
        <diff.DiffExtension implementation="dev.tweety.reviewqueue.ui.ReviewDiffExtension"/>
    </extensions>

    <actions>
        <!--
          These four lived inside a ReviewQueue.Toolbar group that KAN-5 deleted along with the tool
          window it filled. They are declared top-level, with no add-to-group, so that every id keeps
          a registry home: Find Action and user keymap customisation both resolve by id, and an id
          that leaves the registry silently takes those away. End Review matters most — without it the
          only ways out of a pass would be the diff toolbar button and closing the tab.
        -->
        <action id="ReviewQueue.StartReview"
                class="dev.tweety.reviewqueue.actions.StartReviewAction"
                text="Start Review"
                description="Hide the Project panel and walk the unreviewed files one at a time">
            <!--
              macOS only, joining the Cmd+Option+Shift cluster. meta is the Windows key on $default,
              so this ships shortcutless on Windows and Linux, where the Tools menu group and Find
              Action are the way in. NavigationShortcutTest pins that the cluster is macOS-only.

              Known, accepted overlap — three platform actions reach this chord, two different ways,
              and the difference is the whole risk:
                - ForceRefresh: declared on meta alt shift R in Mac OS X 10.5+. An EmptyAction
                  shortcut holder, so never enabled itself.
                - DatabaseView.ForceRefresh: borrows it via use-shortcut-of. Live only with the
                  Database view focused.
                - ReloadScriptConfiguration: does NOT borrow. It declares ctrl alt shift R on
                  $default, and MacOSDefaultKeymap translates Ctrl to Meta, so on macOS it answers to
                  this chord while editing a Kotlin script — any *.gradle.kts, including this
                  plugin's own build files. This is the live contender, and the reason the accepted
                  risk is higher than "Database view only". Do not simplify this comment back to
                  "borrowed by": a maintainer reading it at Gate C would conclude the only live
                  contender is Database-scoped and keep a binding that fires a chooser in build.gradle.kts.
              None can be unbound — remove="true" strips a shortcut from our own action only. Whether
              an action-chooser popup actually appears is a Gate C manual check, and it must be run
              with a .gradle.kts open as well as without one. StartReviewShortcutTest pins the whole
              overlapping id set so a platform change is not silent.
            -->
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift R"/>
        </action>
        <action id="ReviewQueue.EndReview"
                class="dev.tweety.reviewqueue.actions.EndReviewAction"
                text="End Review"
                description="Leave the guided review and restore the Project panel"/>
        <action id="ReviewQueue.Refresh"
                class="dev.tweety.reviewqueue.actions.RefreshQueueAction"
                text="Refresh"
                description="Re-read the review scope now"/>
        <action id="ReviewQueue.ResetAll"
                class="dev.tweety.reviewqueue.actions.ResetAllAction"
                text="Reset All"
                description="Clear every reviewed mark in this project"/>

        <action id="ReviewQueue.ShowFileList"
                class="dev.tweety.reviewqueue.actions.ShowFileListAction"
                text="Show File List"
                description="List every file in the review scope with its reviewed state"/>
        <!--
          The Cmd+Option+Shift cluster below is macOS-only on purpose. Cmd is a Mac key, and the
          Windows equivalent (Win+Alt+Shift+arrow) collides with OS window snapping. On other
          platforms these actions ship shortcutless and are reachable from the diff toolbar.
        -->
        <action id="ReviewQueue.PreviousFile"
                class="dev.tweety.reviewqueue.actions.PreviousFileAction"
                text="Previous File"
                description="Go back one file without changing its reviewed mark">
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta shift LEFT"/>
        </action>
        <action id="ReviewQueue.NextFile"
                class="dev.tweety.reviewqueue.actions.NextFileAction"
                text="Next File"
                description="Go forward one file without changing its reviewed mark">
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta shift RIGHT"/>
        </action>
        <action id="ReviewQueue.PreviousChange"
                class="dev.tweety.reviewqueue.actions.PreviousChangeAction"
                text="Previous Change"
                description="Move to the previous changed region in the file on screen">
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta shift UP"/>
        </action>
        <action id="ReviewQueue.NextChange"
                class="dev.tweety.reviewqueue.actions.NextChangeAction"
                text="Next Change"
                description="Move to the next changed region in the file on screen">
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta shift DOWN"/>
        </action>
        <action id="ReviewQueue.MarkReviewed"
                class="dev.tweety.reviewqueue.actions.MarkReviewedAction"
                text="Mark Reviewed"
                description="Mark this file reviewed and open the next one">
            <!--
              Four chords, so the action is reachable wherever the reader's hand is resting.
              Alt+Shift+ Z / Space / Enter are platform-neutral; the undo-style chord is
              Cmd+Shift+Z on macOS and Ctrl+Shift+Z elsewhere.

              Two are knowingly shared with bundled actions - Ctrl+Shift+Z is $Redo, Alt+Shift+Enter
              is SplitChooser and the Grid plugin. Tolerable only because MarkReviewedAction.update
              enables this action solely inside the review diff viewer, whose editors are read-only,
              so those actions are disabled exactly where this one is live.

              Never bind this to Ctrl+Shift+Space (SmartTypeCompletion) or anything in the macOS
              Cmd+Space family (input-source switching eats it before the IDE sees the key).
              MarkReviewedShortcutTest pins every one of these decisions.
            -->
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift Z"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift SPACE"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift ENTER"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control shift Z"/>
            <!--
              A plugin keyboard-shortcut on a child keymap ADDS to what that keymap inherits, so the
              removal is required: without it macOS would answer to Ctrl+Shift+Z as well, and that is
              $Redo there too (the macOS keymap never redeclares $Redo).
            -->
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift Z"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control shift Z" remove="true"/>
            <!-- macOS-only, matching the Cmd+Option+Shift navigation cluster. -->
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta shift SPACE"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta shift ENTER"/>
        </action>
        <action id="ReviewQueue.ToggleReviewed"
                class="dev.tweety.reviewqueue.actions.ToggleReviewedAction"
                text="Toggle Reviewed"
                description="Add or remove the reviewed mark on this file, without moving to another file"/>

        <!--
          The diff's context menu. Registered as a group with a class so its children can be composed
          at popup time: the platform tail must be read live, or entries other plugins contribute to
          Diff.EditorPopupMenu are silently dropped. Installed onto a viewer's editors by
          ReviewDiffExtension, never by add-to-group — the menu belongs to this plugin's diffs only.
        -->
        <group id="ReviewQueue.DiffPopup"
               class="dev.tweety.reviewqueue.actions.diff.ReviewDiffPopupGroup"/>

        <!--
          The out-of-session surface, replacing the deleted tool window. Declared last in <actions> on
          purpose: <reference ref="..."> resolves at registration time and requires the referenced id
          to already exist, so putting the group after every <action> above makes the ordering
          requirement structural rather than something to remember.
        -->
        <group id="ReviewQueue.Menu" text="Review Queue" popup="true"
               class="com.intellij.openapi.actionSystem.DefaultActionGroup">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <!--
              popup="true" on both groups is required: without it the children are inlined flat into
              the parent menu. text= is required too, or the submenu renders unnamed.

              A fresh id rather than reusing ReviewQueue.Scope, which was an <action> for the scope
              combo box that KAN-5 deleted along with the tool window it sat in: reusing an action id
              for a group would let existing keymap or menu customisation degrade silently.
            -->
            <group id="ReviewQueue.ScopeMenu" text="Scope" popup="true"
                   description="Choose what the review queue lists"
                   class="com.intellij.openapi.actionSystem.DefaultActionGroup">
                <action id="ReviewQueue.SetStaged"
                        class="dev.tweety.reviewqueue.actions.SetStagedAction"
                        text="Staged"/>
                <action id="ReviewQueue.SetBranchVsBase"
                        class="dev.tweety.reviewqueue.actions.SetBranchVsBaseAction"
                        text="Branch vs Base…"/>
                <action id="ReviewQueue.SetCommitRange"
                        class="dev.tweety.reviewqueue.actions.SetCommitRangeAction"
                        text="Commit Range…"/>
            </group>

            <reference ref="ReviewQueue.StartReview"/>
            <reference ref="ReviewQueue.ShowFileList"/>
            <separator/>
            <reference ref="ReviewQueue.Refresh"/>
            <reference ref="ReviewQueue.ResetAll"/>
        </group>
    </actions>
</idea-plugin>
